rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Formulaire public : tout le monde peut CRÉER un message.
    // Lecture / modification / suppression : uniquement admin connecté (Google).
    //
    // IMPORTANT : republier ces règles dans Firebase Console → Firestore → Règles
    // (ou : firebase deploy --only firestore:rules) sinon le site garde l'ancienne config.
    match /contact_submissions/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Contenu éditorial : lecture publique, écriture admin
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
