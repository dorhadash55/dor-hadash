rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'dor.hadash55@gmail.com',
          'dorhadash5780@gmail.com'
        ];
    }

    function isValidContactCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'prenom', 'nom', 'email', 'telephone',
          'ville', 'horizon', 'message', 'createdAt', 'read'
        ])
        && d.id is string && d.id.size() > 0 && d.id.size() < 80
        && d.prenom is string && d.prenom.size() > 0 && d.prenom.size() < 100
        && d.nom is string && d.nom.size() > 0 && d.nom.size() < 100
        && d.email is string && d.email.size() > 3 && d.email.size() < 200
        && d.telephone is string && d.telephone.size() < 40
        && d.ville is string && d.ville.size() < 120
        && d.horizon is string && d.horizon.size() < 120
        && d.message is string && d.message.size() < 5000
        && d.createdAt is string && d.createdAt.size() < 40
        && d.read is bool
        && d.read == false;
    }

    function isPlusOne(field) {
      return field in request.resource.data
        && request.resource.data[field] is int
        && (
          (!(field in resource.data) && request.resource.data[field] == 1)
          || (resource.data[field] is int
            && request.resource.data[field] == resource.data[field] + 1)
        );
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Messages du formulaire : création publique, lecture uniquement admin
    match /contact_submissions/{id} {
      allow create: if isValidContactCreate();
      allow read, update, delete: if isAdmin();
    }

    // Compteurs : +1 seulement (cookies acceptés côté site)
    match /analytics/stats {
      allow read: if isAdmin();
      allow create: if request.resource.data.pageViews is int
        && request.resource.data.pageViews >= 0
        && request.resource.data.pageViews <= 1
        && (!('clicks' in request.resource.data)
          || (request.resource.data.clicks is int
            && request.resource.data.clicks >= 0
            && request.resource.data.clicks <= 1));
      allow update: if isAdmin() || (
        onlyChanged(['pageViews', 'updatedAt']) && isPlusOne('pageViews')
      ) || (
        onlyChanged(['clicks', 'updatedAt']) && isPlusOne('clicks')
      );
    }

    // Contenu du site : lecture publique, écriture admin seulement
    match /site/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tout le reste : admin uniquement (pas de lecture publique des messages)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
