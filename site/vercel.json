{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/contact.ts": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://dor-hadash-a1202.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/admin/blog/:slug/edit",
      "destination": "/admin"
    }
  ]
}
